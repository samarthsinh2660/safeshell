#!/bin/sh
set -e
if [ "$1" = configure ]; then
  if command -v apparmor_parser >/dev/null 2>&1 && [ -f /etc/apparmor.d/safeshell-ss ]; then
    apparmor_parser -r /etc/apparmor.d/safeshell-ss || true
  fi
  echo "SafeShell installed. Each user runs:  safeshell install   (then optionally: safeshell ai setup)"
fi
exit 0
