# Optional: keeps the SafeShell daemon running for your user.
#   mkdir -p ~/.config/systemd/user && cp safeshell.service ~/.config/systemd/user/
#   systemctl --user enable --now safeshell
# Uses the first safeshell found in ~/.local/bin (scripts/install.sh, tarball), /usr/local/bin, /usr/bin (the .deb).
# After an upgrade a daemon of the old version exits with an error on its first request, so systemd
# starts the installed version again (checks run directly in the meantime).
[Unit]
Description=SafeShell daemon (keeps command checks fast)

[Service]
ExecStart=/bin/sh -c 'for p in %h/.local/bin/safeshell /usr/local/bin/safeshell /usr/bin/safeshell; do [ -x "$$p" ] && exec "$$p" daemon; done; exit 1'
Restart=on-failure

[Install]
WantedBy=default.target
